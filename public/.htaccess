Options -Indexes
DirectoryIndex index.html

# The site is a single static page: no rewrite is needed for client-side routes,
# only host canonicalisation and TLS.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTP_HOST} !^markting\.guillaumeyves\.fr$ [NC]
  RewriteRule ^ https://markting.guillaumeyves.fr%{REQUEST_URI} [R=301,L]

  # The proxy condition avoids a redirect loop when Infomaniak terminates HTTPS
  # in front of Apache.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://markting.guillaumeyves.fr%{REQUEST_URI} [R=301,L]
</IfModule>

ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; img-src 'self' data:; manifest-src 'self'; media-src 'self'; object-src 'none'; script-src 'self' 'sha256-0s2di4iBmHZfivmizFW7kLOifLB/zWeG7w1psL45IM8='; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; worker-src 'self'; upgrade-insecure-requests"

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Vite hashes everything under /assets, so it can be cached permanently.
  SetEnvIf Request_URI "^/assets/" immutable_asset
  Header set Cache-Control "public, max-age=31536000, immutable" env=immutable_asset

  # Fonts keep stable names but never change in practice.
  SetEnvIf Request_URI "^/fonts/" font_asset
  Header set Cache-Control "public, max-age=31536000, immutable" env=font_asset

  SetEnvIf Request_URI "^/(?:apple-touch-icon|favicon(?:-16x16|-32x32|-48x48)?|icon-(?:192|512))\.(?:ico|png)$" brand_asset
  SetEnvIf Request_URI "^/(?:og-image\.jpg|site\.webmanifest|robots\.txt|sitemap\.xml)$" brand_asset
  Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400" env=brand_asset
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/manifest+json application/xml image/svg+xml text/css text/html text/javascript text/plain text/xml
</IfModule>

<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript application/json application/manifest+json application/xml image/svg+xml text/css text/html text/javascript text/plain text/xml
  </IfModule>
</IfModule>
